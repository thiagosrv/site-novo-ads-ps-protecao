# Local secrets for `wrangler dev` / `opennextjs-cloudflare preview` — copy to
# `.dev.vars` (gitignored) and fill in. These are separate from `.env.local`,
# which `next dev` still uses; OpenNext reads both when running locally.
#
# NEXTJS_ENV picks which .env file Next.js loads when running on the Workers
# runtime locally (mirrors `next dev`'s NODE_ENV-based .env selection).
NEXTJS_ENV=development

# Same values as .env.example / .env.local — see that file for where each
# one comes from (Neon Postgres, Cloudflare R2, admin auth).
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
